# Running on anything older than the engines range fails in confusing ways: the
# build script is TypeScript that Node 24 strips by itself, so an older Node
# reports an unknown .mts file extension rather than a version problem.
engine-strict=true

# No production dependency here needs an install script. npm 11 blocks them by
# default and warns on every install; saying so explicitly keeps the behaviour
# the same on older npm and drops the warning. esbuild is the only dependency
# that ships one, and it does not need it: the platform binary arrives through
# its optional @esbuild/<platform> dependency.
ignore-scripts=true
