{
  "name": "@doctor_internet/deployment-for-gmodstore",
  "version": "2.1.0",
  "description": "GitHub Action for deploying to GModStore.",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mts",
    "build:watch": "node scripts/build.mts --watch",
    "clean": "node scripts/build.mts --clean",
    "build:check": "node scripts/build.mts --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build:check"
  },
  "repository": {
    "type": "github",
    "url": "https://github.com/JoshPiper/deployment-for-gmodstore.git"
  },
  "keywords": [],
  "author": "John Internet <internet@doctor-internet.dev>",
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "semver": "^7.7.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
